<div class="privat-sheet privat-sheet--search" data-drawer="search">
  <div class="privat-sheet__head">
    <h3 class="privat-sheet__title">Поиск</h3>
    <button type="button" class="privat-close" data-close aria-label="Закрыть">✕</button>
  </div>
  <div class="privat-search__field">
    <input type="text" id="privat-search-input" class="privat-input privat-input--search" placeholder="Что ищете?" autocomplete="off">
  </div>
  <div class="privat-sheet__scroll">
    <div class="privat-search__idle" id="privat-search-idle">Например: смазка, свеча, феромоны…</div>
    <div id="privat-search-results"></div>
  </div>
</div>
