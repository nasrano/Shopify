<div class="privat-sheet" data-drawer="acc">
  <div class="privat-sheet__head">
    <h3 class="privat-sheet__title">Аккаунт</h3>
    <button type="button" class="privat-close" data-close aria-label="Закрыть">✕</button>
  </div>
  <div class="privat-account">
    {% if customer %}
      <p class="privat-account__text">Вы вошли как {{ customer.name | default: customer.email }}.</p>
      <a href="{{ routes.account_url }}" class="privat-btn" style="display:block;text-align:center;margin-bottom:10px">Мои заказы</a>
      <a href="{{ routes.account_logout_url }}" class="privat-account__submit" style="display:block;text-align:center;text-decoration:none">Выйти</a>
    {% else %}
      <p class="privat-account__text">Войдите по номеру телефона — заказы, избранное и бонусы будут под рукой. Никаких лишних данных.</p>
      <form action="{{ routes.account_login_url }}" method="post">
        <input class="privat-input" type="text" name="customer[phone]" placeholder="+996 ___ ___ ___" autocomplete="tel">
        <button type="submit" class="privat-account__submit">Получить код</button>
      </form>
    {% endif %}
  </div>
</div>
