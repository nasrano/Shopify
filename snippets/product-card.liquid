{%- comment -%} params: product, badge ("none" | "new" | "sale"), eager (bool — первые видимые карточки), priority (bool — LCP-кандидаты). Скрытие распроданных теперь на уровне каталога: демон переводит товар с нулевым остатком в статус «Скрытый» (UNLISTED) — в коллекции он не попадает. Здесь распроданное больше не прячем: между продажей и следующим синком карточка честно показывает «Нет в наличии». {%- endcomment -%}
{%- assign variant = product.selected_or_first_available_variant -%}
{%- assign on_sale = false -%}
{%- if variant.compare_at_price > variant.price -%}{%- assign on_sale = true -%}{%- endif -%}
{%- assign fav_image = '' -%}
{%- if product.featured_image -%}{%- assign fav_image = product.featured_image | image_url: width: 200, format: 'webp' -%}{%- endif -%}

<div class="privat-card">
  <a href="{{ product.url }}" class="privat-card__imgwrap{% if product.featured_image %} privat-card__imgwrap--photo{% endif %}">
    {% if product.featured_image %}
      <img class="privat-card__img"
        src="{{ product.featured_image | image_url: width: 320, format: 'webp' }}"
        srcset="{{ product.featured_image | image_url: width: 240, format: 'webp' }} 240w,
                {{ product.featured_image | image_url: width: 320, format: 'webp' }} 320w,
                {{ product.featured_image | image_url: width: 480, format: 'webp' }} 480w,
                {{ product.featured_image | image_url: width: 640, format: 'webp' }} 640w"
        sizes="(min-width: 1080px) 232px, (min-width: 720px) 200px, 50vw"
        width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}"
        alt="{{ product.featured_image.alt | default: product.title | escape }}"
        {% if eager %}loading="eager"{% if priority %} fetchpriority="high"{% endif %}{% else %}loading="lazy"{% endif %} decoding="async">
    {% else %}
      <span class="privat-card__ph">фото товара</span>
    {% endif %}

    {% if badge == 'new' %}
      <span class="privat-card__badge privat-card__badge--new">NEW</span>
    {% elsif on_sale %}
      {% assign pct = variant.compare_at_price | minus: variant.price | times: 100 | divided_by: variant.compare_at_price %}
      <span class="privat-card__badge privat-card__badge--sale">−{{ pct }}%</span>
    {% endif %}

    <button type="button" class="privat-card__fav" data-fav-toggle
      data-product-id="{{ product.id }}"
      data-product-title="{{ product.title | escape }}"
      data-product-price="{{ variant.price | money }}"
      data-product-image="{{ fav_image }}"
      data-product-url="{{ product.url }}"
      data-product-sku="{{ variant.sku | escape }}"
      data-variant-id="{{ variant.id }}"
      aria-label="В избранное"><svg width="16" height="16" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M11 18.6C6.7 15.3 3.8 12.6 3.8 9.6c0-2.2 1.7-3.9 3.9-3.9 1.3 0 2.5.6 3.3 1.7.8-1.1 2-1.7 3.3-1.7 2.2 0 3.9 1.7 3.9 3.9 0 3-2.9 5.7-7.2 9Z"/></svg></button>
  </a>
  <div class="privat-card__body">
    <a href="{{ product.url }}" class="privat-card__name" style="color:inherit;text-decoration:none">{{ product.title }}</a>
    {% if variant.sku != blank %}
      <div class="privat-card__code">Код: {{ variant.sku }}</div>
    {% endif %}
    {% if on_sale %}
      <div class="privat-card__price-row">
        <span class="privat-card__price">{{ variant.price | money }}</span>
        <span class="privat-card__old">{{ variant.compare_at_price | money }}</span>
      </div>
    {% else %}
      <div class="privat-card__price">{{ variant.price | money }}</div>
    {% endif %}
    <button type="button" class="privat-card__add" data-add-to-cart data-variant-id="{{ variant.id }}"{% unless variant.available %} disabled{% endunless %}>
      {% if variant.available %}В корзину{% else %}Нет в наличии{% endif %}
    </button>
  </div>
</div>
