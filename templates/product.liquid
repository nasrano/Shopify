{%- assign variant = product.selected_or_first_available_variant -%}
{%- assign on_sale = false -%}
{%- if variant.compare_at_price > variant.price -%}{%- assign on_sale = true -%}{%- endif -%}

<div class="privat-product">
  <div class="privat-product__media"
    {% if product.featured_image %}style="background-image:url({{ product.featured_image | image_url: width: 900 }})"{% endif %}>
    {% unless product.featured_image %}<span class="privat-card__ph">фото товара</span>{% endunless %}
    <button type="button" class="privat-card__fav" data-fav-toggle
      data-product-id="{{ product.id }}"
      data-product-title="{{ product.title | escape }}"
      data-product-price="{{ variant.price | money }}"
      data-product-image="{% if product.featured_image %}{{ product.featured_image | image_url: width: 200 }}{% endif %}"
      data-product-url="{{ product.url }}"
      data-variant-id="{{ variant.id }}"
      aria-label="В избранное">♡</button>
  </div>

  {% if product.images.size > 1 %}
    <div class="privat-product__thumbs">
      {% for image in product.images %}
        <a href="{{ image | image_url: width: 1200 }}" class="privat-product__thumb" style="background-image:url({{ image | image_url: width: 128 }})"></a>
      {% endfor %}
    </div>
  {% endif %}

  <div class="privat-product__body">
    <h1 class="privat-product__title">{{ product.title }}</h1>
    <div class="privat-product__price-row">
      <span class="privat-product__price{% if on_sale %} privat-product__price--sale{% endif %}">{{ variant.price | money }}</span>
      {% if on_sale %}<span class="privat-product__old">{{ variant.compare_at_price | money }}</span>{% endif %}
    </div>

    {% form 'product', product %}
      {% if product.variants.size > 1 %}
        <select name="id" class="privat-select" aria-label="Вариант">
          {% for v in product.variants %}
            <option value="{{ v.id }}"
              {% if v.id == variant.id %}selected{% endif %}
              {% unless v.available %}disabled{% endunless %}>
              {{ v.title }} — {{ v.price | money }}{% unless v.available %} · нет в наличии{% endunless %}
            </option>
          {% endfor %}
        </select>
      {% else %}
        <input type="hidden" name="id" value="{{ variant.id }}">
      {% endif %}
      <div class="privat-form-row">
        <input class="privat-input" type="number" name="quantity" value="1" min="1" aria-label="{{ 'products.product.quantity' | t }}" style="max-width:92px;text-align:center">
        <button type="submit" class="privat-checkout-btn" {% unless product.available %}disabled{% endunless %}>
          {% if product.available %}{{ 'products.product.add_to_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}
        </button>
      </div>
    {% endform %}

    {% if product.description != blank %}
      <div class="privat-product__desc">{{ product.description }}</div>
    {% endif %}
  </div>
</div>
