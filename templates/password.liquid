{% layout none %}
<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ 'password_page.title' | t }} · {{ shop.name }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Prata&family=Manrope:wght@400;600;700&display=swap" rel="stylesheet">
  {{ 'theme.css' | asset_url | stylesheet_tag }}
</head>
<body>
  <div class="privat-outer" style="align-items:center">
    <div class="privat-panel" style="max-width:360px;margin:24px;text-align:center">
      <div class="privat-header__logo-name" style="margin-bottom:2px">PRIVAT</div>
      <div class="privat-header__logo-sub" style="margin-bottom:16px">SEX SHOP</div>
      <h1 class="privat-page__title" style="font-size:20px">{{ 'password_page.title' | t }}</h1>
      <p class="privat-form-note">{{ 'password_page.text' | t }}</p>
      {% form 'storefront_password' %}
        {% if form.errors %}<p class="privat-form-errors">{{ form.errors | default_errors }}</p>{% endif %}
        <input class="privat-input" type="password" name="password" placeholder="Пароль" autocomplete="current-password">
        <button type="submit" class="privat-account__submit">{{ 'password_page.submit' | t }}</button>
      {% endform %}
    </div>
  </div>
</body>
</html>
