<section class="privat-blog">
  <h1 class="privat-page__title">{{ blog.title }}</h1>

  {% paginate blog.articles by 12 %}
    <div class="privat-blog__grid">
      {% for article in blog.articles %}
        <a href="{{ article.url }}" class="privat-blog-card">
          <div class="privat-blog-card__img{% if article.image %} privat-blog-card__img--photo{% endif %}">
            {% if article.image %}
              <img class="privat-blog-card__media"
                src="{{ article.image | image_url: width: 800 }}"
                srcset="{{ article.image | image_url: width: 400 }} 400w,
                        {{ article.image | image_url: width: 800 }} 800w"
                sizes="(min-width: 720px) 420px, 100vw"
                width="{{ article.image.width }}" height="{{ article.image.height }}"
                alt="{{ article.title | escape }}"
                {% if forloop.index <= 2 %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %} decoding="async">
            {% else %}
              <span class="privat-card__ph">фото записи</span>
            {% endif %}
            <span class="privat-blog-card__date">{{ article.published_at | date: '%d.%m.%Y' }}</span>
          </div>
          <div class="privat-blog-card__body">
            <div class="privat-blog-card__title">{{ article.title }}</div>
            <div class="privat-blog-card__excerpt">{{ article.excerpt_or_content | strip_html | truncate: 140 }}</div>
            <span class="privat-blog-card__more">Читать →</span>
          </div>
        </a>
      {% else %}
        <p class="privat-form-note">Записей пока нет.</p>
      {% endfor %}
    </div>

    {% if paginate.pages > 1 %}
      <div class="privat-pagination">
        {% if paginate.previous %}<a href="{{ paginate.previous.url }}">{{ 'general.pagination.previous' | t }}</a>{% endif %}
        <span class="privat-pagination__current">{{ paginate.current_page }} / {{ paginate.pages }}</span>
        {% if paginate.next %}<a href="{{ paginate.next.url }}">{{ 'general.pagination.next' | t }}</a>{% endif %}
      </div>
    {% endif %}
  {% endpaginate %}
</section>
