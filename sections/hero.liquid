{%- comment -%}
  Картинки: сначала настройки темы (settings.hero_*, их же преload'ит <head>), иначе — настройки
  секции. Preload ниже оставляем как СТРАХОВКУ: если картинки заданы в теме, head уже их
  преload'ит и этот дубликат браузер отбросит; если в теме не заданы — этот preload единственный,
  регрессии нет.
{%- endcomment -%}
{%- assign img_desktop = settings.hero_desktop | default: section.settings.image | default: section.settings.image_mobile -%}
{%- assign img_mobile = settings.hero_mobile | default: section.settings.image_mobile | default: section.settings.image -%}
{%- if img_mobile -%}
  <link rel="preload" as="image" media="(max-width:719px)" href="{{ img_mobile | image_url: width: 800, format: 'webp' }}"
    imagesrcset="{{ img_mobile | image_url: width: 600, format: 'webp' }} 600w, {{ img_mobile | image_url: width: 800, format: 'webp' }} 800w, {{ img_mobile | image_url: width: 1000, format: 'webp' }} 1000w"
    imagesizes="100vw" fetchpriority="high">
  <link rel="preload" as="image" media="(min-width:720px)" href="{{ img_desktop | image_url: width: 1800, format: 'webp' }}"
    imagesrcset="{{ img_desktop | image_url: width: 1200, format: 'webp' }} 1200w, {{ img_desktop | image_url: width: 1800, format: 'webp' }} 1800w"
    imagesizes="100vw" fetchpriority="high">
{%- endif -%}
<section class="privat-hero">
  <div class="privat-hero__img" id="privat-hero-img">
    {%- if img_mobile -%}
      <picture>
        {%- if img_desktop -%}
          <source media="(min-width:720px)"
            srcset="{{ img_desktop | image_url: width: 1200, format: 'webp' }} 1200w,
                    {{ img_desktop | image_url: width: 1800, format: 'webp' }} 1800w"
            sizes="100vw">
        {%- endif -%}
        <img class="privat-hero__media"
          src="{{ img_mobile | image_url: width: 800, format: 'webp' }}"
          srcset="{{ img_mobile | image_url: width: 600, format: 'webp' }} 600w,
                  {{ img_mobile | image_url: width: 800, format: 'webp' }} 800w,
                  {{ img_mobile | image_url: width: 1000, format: 'webp' }} 1000w"
          sizes="100vw"
          width="{{ img_mobile.width }}" height="{{ img_mobile.height }}"
          alt="{{ section.settings.title | default: 'PRIVAT' | escape }}"
          fetchpriority="high" loading="eager" decoding="async">
      </picture>
    {%- else -%}
      <span class="privat-hero__placeholder">lifestyle фото · пара / уют / тёплый свет</span>
    {%- endif -%}
  </div>
  <div class="privat-hero__scrim"></div>
  <div class="privat-hero__tag" id="privat-hero-tag">
    <h1 class="privat-hero__title">{{ section.settings.title | default: 'Близость — это забота о себе' }}</h1>
    <p class="privat-hero__sub">{{ section.settings.subtitle | default: 'Подберём бережно, честно и без неловкости. Анонимно — от выбора до доставки.' }}</p>
    <div class="privat-hero__ctas">
      <a href="{{ section.settings.primary_url | default: routes.all_products_collection_url }}" class="privat-btn">{{ section.settings.primary_label | default: 'В магазин →' }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Герой",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Изображение — десктоп (горизонтальное)" },
    { "type": "image_picker", "id": "image_mobile", "label": "Изображение — мобильный (вертикальное 3:4)", "info": "Если не задано, на мобильном используется десктопное с обрезкой по центру." },
    { "type": "text", "id": "title", "label": "Заголовок", "default": "Близость — это забота о себе" },
    { "type": "textarea", "id": "subtitle", "label": "Подзаголовок", "default": "Подберём бережно, честно и без неловкости. Анонимно — от выбора до доставки." },
    { "type": "text", "id": "primary_label", "label": "Кнопка — текст", "default": "В магазин →" },
    { "type": "url", "id": "primary_url", "label": "Кнопка — ссылка" }
  ],
  "presets": [{ "name": "Герой" }]
}
{% endschema %}
