<section class="privat-about" data-reveal>
  <h2 class="privat-h2">{{ section.settings.heading | default: 'О нас' }}</h2>
  <p>{{ section.settings.text_1 | default: 'Мы верим, что близость — нормальная и здоровая часть жизни. PRIVAT — это место, где о ней можно говорить спокойно: без стеснения, давления и лишних глаз.' }}</p>
  <p class="privat-about__muted">{{ section.settings.text_2 | default: 'Каждый товар мы отбираем сами: сертифицированные материалы, проверенные бренды и честные цены. А если сомневаетесь — тактично подскажем, с чего начать.' }}</p>
</section>

{% schema %}
{
  "name": "О нас",
  "settings": [
    { "type": "text", "id": "heading", "label": "Заголовок", "default": "О нас" },
    { "type": "textarea", "id": "text_1", "label": "Текст 1", "default": "Мы верим, что близость — нормальная и здоровая часть жизни. PRIVAT — это место, где о ней можно говорить спокойно: без стеснения, давления и лишних глаз." },
    { "type": "textarea", "id": "text_2", "label": "Текст 2", "default": "Каждый товар мы отбираем сами: сертифицированные материалы, проверенные бренды и честные цены. А если сомневаетесь — тактично подскажем, с чего начать." }
  ],
  "presets": [{ "name": "О нас" }]
}
{% endschema %}
