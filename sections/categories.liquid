{%- comment -%}
  Сетка категорий: пункты ПЕРВОГО уровня «Меню категорий». Пункт считается
  категорией, если ведёт на коллекцию ИЛИ имеет вложенные пункты (родитель
  с URL «#»). Родители без своей коллекции открывают шторку категорий сразу
  на своём подуровне. Пока категорий в меню нет — коллекции магазина.
{%- endcomment -%}
{%- assign menu = linklists[settings.categories_menu] -%}
{%- assign cat_count = 0 -%}
{%- for link in menu.links -%}
  {%- if link.type == 'collection_link' or link.url contains '/collections/' or link.links.size > 0 -%}
    {%- assign cat_count = cat_count | plus: 1 -%}
  {%- endif -%}
{%- endfor -%}

<section class="privat-cats" data-reveal>
  <div class="privat-cats__head">
    <h2 class="privat-h2">{{ section.settings.heading | default: 'Категории' }}</h2>
    <button type="button" class="privat-link-all" data-open="cats">Все →</button>
  </div>
  <div class="privat-cats__grid">
    {% if cat_count > 0 %}
      {% for link in menu.links %}
        {%- assign has_col_url = false -%}
        {%- if link.type == 'collection_link' or link.url contains '/collections/' -%}{%- assign has_col_url = true -%}{%- endif -%}
        {% if has_col_url %}
          <a href="{{ link.url }}" class="privat-cat">
            <span class="privat-cat__mono">{{ link.title | slice: 0, 1 | upcase }}</span>
            <span class="privat-cat__name">{{ link.title }}</span>
          </a>
        {% elsif link.links.size > 0 %}
          <button type="button" class="privat-cat" data-open="cats" data-cat-target="p{{ forloop.index }}">
            <span class="privat-cat__mono">{{ link.title | slice: 0, 1 | upcase }}</span>
            <span class="privat-cat__name">{{ link.title }}</span>
          </button>
        {% endif %}
      {% endfor %}
    {% else %}
      {% for c in collections limit: 12 %}
        {% unless c.handle == 'frontpage' or c.handle == 'all' %}
          <a href="{{ c.url }}" class="privat-cat">
            <span class="privat-cat__mono">{{ c.title | slice: 0, 1 | upcase }}</span>
            <span class="privat-cat__name">{{ c.title }}</span>
          </a>
        {% endunless %}
      {% endfor %}
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Категории",
  "settings": [
    { "type": "text", "id": "heading", "label": "Заголовок", "default": "Категории" },
    { "type": "paragraph", "content": "Показываются пункты первого уровня «Меню категорий» (Тема → Навигация): ссылки на коллекции и родительские пункты с вложенными. Кнопка «Все →» открывает шторку с полным древом." }
  ],
  "presets": [{ "name": "Категории" }]
}
{% endschema %}
