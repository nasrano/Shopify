{%- comment -%}
  Сетка категорий: пункты ПЕРВОГО уровня «Меню категорий», ведущие на коллекции
  (учитываются и пункты-ссылки, вставленные как URL /collections/...).
  Пока таких пунктов нет — коллекции магазина. Плюс кнопка «Все категории»,
  открывающая шторку с полным древом.
{%- endcomment -%}
{%- assign menu = linklists[settings.categories_menu] -%}
{%- assign col_links = 0 -%}
{%- for link in menu.links -%}
  {%- if link.type == 'collection_link' or link.url contains '/collections/' -%}
    {%- assign col_links = col_links | plus: 1 -%}
  {%- endif -%}
{%- endfor -%}

<section class="privat-cats" data-reveal>
  <h2 class="privat-h2">{{ section.settings.heading | default: 'Категории' }}</h2>
  <div class="privat-cats__grid">
    {% if col_links > 0 %}
      {% for link in menu.links %}
        {% if link.type == 'collection_link' or link.url contains '/collections/' %}
          <a href="{{ link.url }}" class="privat-cat">
            <span class="privat-cat__mono">{{ link.title | slice: 0, 1 | upcase }}</span>
            <span class="privat-cat__name">{{ link.title }}</span>
          </a>
        {% endif %}
      {% endfor %}
    {% else %}
      {% for c in collections limit: 11 %}
        {% unless c.handle == 'frontpage' or c.handle == 'all' %}
          <a href="{{ c.url }}" class="privat-cat">
            <span class="privat-cat__mono">{{ c.title | slice: 0, 1 | upcase }}</span>
            <span class="privat-cat__name">{{ c.title }}</span>
          </a>
        {% endunless %}
      {% endfor %}
    {% endif %}
    <button type="button" class="privat-cat privat-cat--all" data-open="cats">
      <span class="privat-cat__mono">→</span>
      <span class="privat-cat__name">Все категории</span>
    </button>
  </div>
</section>

{% schema %}
{
  "name": "Категории",
  "settings": [
    { "type": "text", "id": "heading", "label": "Заголовок", "default": "Категории" },
    { "type": "paragraph", "content": "Показываются пункты первого уровня «Меню категорий», ведущие на коллекции (Тема → Навигация). Пока таких пунктов нет — коллекции магазина. Последняя карточка «Все категории» открывает шторку с полным древом." }
  ],
  "presets": [{ "name": "Категории" }]
}
{% endschema %}
