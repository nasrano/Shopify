{% if section.settings.promo_enabled %}
  <div class="privat-promo">{{ section.settings.promo_text }}</div>
{% endif %}

<header class="privat-header">
  <button type="button" class="privat-header__burger" data-open="menu" aria-label="Меню">
    <span></span><span></span><span></span>
  </button>

  <nav class="privat-header__links">
    {% for link in linklists[settings.menu].links limit: 4 %}
      <a href="{{ link.url }}">{{ link.title }}</a>
    {% endfor %}
  </nav>

  <a href="{{ routes.root_url }}" class="privat-header__logo" data-go-home>
    <div class="privat-header__logo-name">{{ section.settings.logo_text | default: 'PRIVAT' }}</div>
    <div class="privat-header__logo-sub">{{ section.settings.logo_subtext | default: 'SEX SHOP' }}</div>
  </a>

  <div class="privat-header__actions">
    <button type="button" class="privat-header__icon privat-desktop-only" data-open="cats" aria-label="Категории">
      <svg width="21" height="21" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="4" y="4" width="6" height="6" rx="1.5"></rect><rect x="12" y="4" width="6" height="6" rx="1.5"></rect><rect x="4" y="12" width="6" height="6" rx="1.5"></rect><rect x="12" y="12" width="6" height="6" rx="1.5"></rect></svg>
    </button>
    <button type="button" class="privat-header__icon privat-desktop-only" data-open="search" aria-label="Поиск">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="9" cy="9" r="6.2"></circle><line x1="13.6" y1="13.6" x2="18" y2="18"></line></svg>
    </button>
    <button type="button" class="privat-header__icon" data-open="favs" aria-label="Избранное">
      <svg width="21" height="21" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M11 18.6C6.7 15.3 3.8 12.6 3.8 9.6c0-2.2 1.7-3.9 3.9-3.9 1.3 0 2.5.6 3.3 1.7.8-1.1 2-1.7 3.3-1.7 2.2 0 3.9 1.7 3.9 3.9 0 3-2.9 5.7-7.2 9Z"/></svg>
      <span class="privat-badge" id="privat-favs-badge" hidden>0</span>
    </button>
    <button type="button" class="privat-header__icon" data-open="cart" aria-label="Корзина">
      <svg width="21" height="21" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 7.5 H18 L17 19 H5 Z"></path><path d="M8 7.5 V6 a3 3 0 0 1 6 0 V7.5"></path></svg>
      <span class="privat-badge" id="privat-cart-badge"{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
    </button>
    <button type="button" class="privat-header__icon privat-desktop-only" data-open="acc" aria-label="Аккаунт">
      <svg width="21" height="21" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="11" cy="8" r="3.4"></circle><path d="M4.5 19 a6.5 6.5 0 0 1 13 0"></path></svg>
    </button>
  </div>
</header>

{% schema %}
{
  "name": "Шапка",
  "settings": [
    { "type": "text", "id": "logo_text", "label": "Название", "default": "PRIVAT" },
    { "type": "text", "id": "logo_subtext", "label": "Подпись под названием", "default": "SEX SHOP" },
    { "type": "header", "content": "Промо-полоса" },
    { "type": "checkbox", "id": "promo_enabled", "label": "Показывать промо-полосу", "default": true },
    { "type": "text", "id": "promo_text", "label": "Текст промо-полосы", "default": "−10% по промокоду LETO26" }
  ]
}
{% endschema %}
