<!DOCTYPE html>
<html lang="ru" class="no-js">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="alternate" hreflang="ru" href="{{ canonical_url }}">
  <link rel="alternate" hreflang="x-default" href="{{ canonical_url }}">
  {%- liquid
    # служебные страницы не должны попадать в индекс — убирает и дубли description по ним
    assign noindex = false
    if template contains 'cart' or template contains 'search' or template contains 'customers' or template contains 'gift_card' or request.path contains '/policies/'
      assign noindex = true
    endif
  -%}
  {%- if noindex -%}<meta name="robots" content="noindex, follow">{%- endif -%}
  {%- liquid
    # SEO title (цель 50–60 симв.) для товаров и коллекций ВСЕГДА генерируется темой
    # по формуле — сохранённые в админке SEO-поля игнорируются (у старых товаров они
    # кривые: обрезаны посреди слова, с кодами). Точечно переопределить можно
    # метаполем custom.seo_title у товара/коллекции.
    # Лесенка суффиксов — берём самый длинный, влезающий в 60 символов.
    assign seo_title = page_title
    if template contains 'product'
      if product.metafields.custom.seo_title != blank
        assign seo_title = product.metafields.custom.seo_title
      else
        assign t_base = product.title
        if product.metafields.custom.h1_suffix != blank
          assign t_base = t_base | append: ' (' | append: product.metafields.custom.h1_suffix | append: ')'
        endif
        assign seo_title = t_base | append: ' — купить в Бишкеке с доставкой за 1 час | Секс шоп PRIVAT'
        if seo_title.size > 60
          assign seo_title = t_base | append: ' — купить в Бишкеке недорого | Секс шоп PRIVAT'
        endif
        if seo_title.size > 60
          assign seo_title = t_base | append: ' — купить в Бишкеке | Секс шоп PRIVAT'
        endif
        if seo_title.size > 60
          assign seo_title = t_base | append: ' — купить в Бишкеке | PRIVAT'
        endif
        if seo_title.size > 60
          assign seo_title = t_base | append: ' | Секс шоп PRIVAT'
        endif
        if seo_title.size > 60
          assign seo_title = t_base | append: ' | PRIVAT'
        endif
        # длинное имя не влезло даже с ' | PRIVAT' -> режем ИМЯ по границе слова и
        # добавляем код товара для уникальности (суффикс тут опускаем — код надёжнее).
        if seo_title.size > 66
          assign sku_code = product.selected_or_first_available_variant.sku
          assign code_part = ''
          if sku_code != blank
            assign code_part = ' · ' | append: sku_code
          endif
          assign budget = 66 | minus: code_part.size | minus: 9
          assign short_name = ''
          assign _words = product.title | split: ' '
          for _w in _words
            assign _trial = short_name | append: _w | append: ' '
            assign _tl = _trial | strip | size
            if _tl <= budget
              assign short_name = _trial
            else
              break
            endif
          endfor
          assign short_name = short_name | strip
          if short_name == blank
            assign short_name = product.title | truncate: budget, ''
          endif
          assign seo_title = short_name | append: code_part | append: ' | PRIVAT'
        endif
      endif
    elsif template == 'index'
      if page_title.size < 50
        assign seo_title = 'Секс шоп PRIVAT — интим-товары в Бишкеке, доставка за 1 час'
      endif
    elsif template contains 'collection' and collection != blank
      if collection.metafields.custom.seo_title != blank
        assign seo_title = collection.metafields.custom.seo_title
      else
        assign c_base = collection.title
        assign seo_title = c_base | append: ' — купить в Бишкеке недорого ❤️ Секс шоп Privat'
        if seo_title.size > 60
          assign seo_title = c_base | append: ' — купить в Бишкеке ❤️ Секс шоп Privat'
        endif
        if seo_title.size > 60
          assign seo_title = c_base | append: ' — купить в Бишкеке ❤️ Privat'
        endif
        if seo_title.size > 60
          assign seo_title = c_base | append: ' ❤️ Секс шоп Privat | Бишкек'
        endif
        if seo_title.size > 60
          assign seo_title = c_base | append: ' ❤️ Privat Бишкек'
        endif
      endif
    endif
  -%}
  {%- liquid
    # Meta description (цель 130–160 симв.): для товаров и коллекций — всегда формула
    # (переопределение — метаполе custom.seo_description); для остальных шаблонов
    # берём заданный page_description, а при его отсутствии — свой fallback на шаблон.
    assign meta_description = ''
    if template contains 'product'
      if product.metafields.custom.seo_description != blank
        assign meta_description = product.metafields.custom.seo_description
      else
        assign price_str = product.price | money_without_currency | strip_html | remove: ' '
        assign p_base = product.title
        if product.metafields.custom.h1_suffix != blank
          assign p_base = p_base | append: ' (' | append: product.metafields.custom.h1_suffix | append: ')'
        endif
        # лесенка: база + хвосты, пока не наберём 130, не превышая 160
        assign meta_description = 'Купить ' | append: p_base | append: ' в Бишкеке — ' | append: price_str | append: ' сом.'
        assign d_try = meta_description | append: ' Анонимная доставка за 1 час, дискретная упаковка.'
        if meta_description.size < 130 and d_try.size <= 160
          assign meta_description = d_try
        endif
        assign d_try = meta_description | append: ' Оплата при получении.'
        if meta_description.size < 130 and d_try.size <= 160
          assign meta_description = d_try
        endif
        assign d_try = meta_description | append: ' Секс шоп PRIVAT ☎ 0500-690-690.'
        if meta_description.size < 130 and d_try.size <= 160
          assign meta_description = d_try
        endif
        assign d_try = meta_description | append: ' Бережный подбор без неловкости.'
        if meta_description.size < 130 and d_try.size <= 160
          assign meta_description = d_try
        endif
        assign d_try = meta_description | append: ' Работаем ежедневно.'
        if meta_description.size < 130 and d_try.size <= 160
          assign meta_description = d_try
        endif
      endif
    elsif template contains 'list-collections'
      assign meta_description = 'Все категории товаров секс шопа PRIVAT в Бишкеке: игрушки, бельё, смазки, БДСМ и другое. Анонимная доставка за 1 час по Бишкеку.'
    elsif template contains 'collection' and collection != blank
      if collection.metafields.custom.seo_description != blank
        assign meta_description = collection.metafields.custom.seo_description
      else
        assign meta_description = collection.title | append: ' — купить в Бишкеке с анонимной доставкой за 1 час. Секс шоп PRIVAT: дискретная упаковка, оплата при получении. ☎ 0500-690-690'
      endif
    elsif template contains 'blog' or template contains 'article'
      assign meta_description = page_description | default: 'Блог PRIVAT — честные статьи об интимной жизни, гайды по выбору игрушек и уходу за ними. Без стеснения и мифов.'
    elsif template contains 'page'
      assign meta_description = page_description | default: ''
      if meta_description == blank
        assign meta_description = page.title | append: ' — секс шоп PRIVAT, Бишкек. Магазин товаров для взрослых: анонимная доставка за 1 час, дискретная упаковка, консультации без неловкости.'
      endif
    else
      assign meta_description = page_description | default: shop.description
      if meta_description == blank
        assign meta_description = 'PRIVAT — магазин товаров для взрослых в Бишкеке. Бережный подбор без неловкости, анонимная упаковка, доставка за 1 час. ☎ 0500-690-690'
      endif
    endif
  -%}
  <meta name="description" content="{{ meta_description | escape }}">
  {% render 'seo-meta', meta_description: meta_description, seo_title: seo_title %}
  <title>
    {{ seo_title }}{% if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags | join: ', ' }}{% endif %}
    {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
    {%- comment -%} бренд добавляем, только если его ещё нет в title; проверка по 'PRIVAT'/'Privat' устойчива к латинской C в «Cекс» {%- endcomment -%}
    {%- unless seo_title contains 'PRIVAT' or seo_title contains 'Privat' or seo_title contains 'privat' %} &ndash; {{ shop.name }}{% endunless -%}
  </title>

  {%- if settings.favicon -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    <link rel="icon" type="image/png" sizes="192x192" href="{{ settings.favicon | image_url: width: 192, height: 192 }}">
    <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
  {%- elsif shop.brand.logo -%}
    <link rel="icon" type="image/png" href="{{ shop.brand.logo | image_url: width: 32, height: 32 }}">
  {%- endif -%}

  {%- comment -%} LCP: preload баннера главной ИЗ HEAD — браузер находит его сразу, а не в теле после CSS/шрифтов. {%- endcomment -%}
  {%- if template == 'index' and settings.hero_mobile -%}
    <link rel="preload" as="image" media="(max-width:719px)" href="{{ settings.hero_mobile | image_url: width: 800, format: 'webp' }}"
      imagesrcset="{{ settings.hero_mobile | image_url: width: 600, format: 'webp' }} 600w, {{ settings.hero_mobile | image_url: width: 800, format: 'webp' }} 800w, {{ settings.hero_mobile | image_url: width: 1000, format: 'webp' }} 1000w"
      imagesizes="100vw" fetchpriority="high">
  {%- endif -%}
  {%- if template == 'index' and settings.hero_desktop -%}
    <link rel="preload" as="image" media="(min-width:720px)" href="{{ settings.hero_desktop | image_url: width: 1800, format: 'webp' }}"
      imagesrcset="{{ settings.hero_desktop | image_url: width: 1200, format: 'webp' }} 1200w, {{ settings.hero_desktop | image_url: width: 1800, format: 'webp' }} 1800w"
      imagesizes="100vw" fetchpriority="high">
  {%- endif -%}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" as="style"
    href="https://fonts.googleapis.com/css2?family=Prata&family=Manrope:wght@400;600;700&display=swap"
    onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Prata&family=Manrope:wght@400;600;700&display=swap"></noscript>

  {{ 'theme.css' | asset_url | stylesheet_tag }}

  <script>document.documentElement.classList.remove('no-js');window.__privatPortal={{ settings.portal_url | default: '' | json }};</script>
  <script>
    (function () {
      try {
        var saved = localStorage.getItem('privat-theme');
        // Светлая тема — по умолчанию. Тёмная включается только если пользователь
        // сам переключил тумблер (системная prefers-color-scheme намеренно игнорируется).
        if (saved === 'dark') {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      } catch (e) {}
    })();
  </script>

  {{ content_for_header }}
</head>
<body>

  <div class="privat-outer">
    <main class="privat-app" id="privat-app">

      <div class="privat-scroller" id="privat-scroller">
        {% section 'header' %}

        {{ content_for_layout }}

        {% section 'footer' %}
      </div>

      {% section 'bottom-nav' %}

      <div class="privat-backdrop" id="privat-backdrop"></div>

      {% section 'menu-drawer' %}
      {% render 'cart-drawer' %}
      {% render 'favorites-drawer' %}
      {% render 'categories-drawer' %}
      {% render 'account-drawer' %}
      {% render 'search-drawer' %}
      {% render 'toast' %}
    </main>
  </div>

  <script id="privat-cart-data" type="application/json">{{ cart | json }}</script>
  <script>
    window.Shopify = window.Shopify || {};
    Shopify.money_format = {{ shop.money_format | json }};
  </script>
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
</body>
</html>
