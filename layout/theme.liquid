<!DOCTYPE html>
<html lang="ru" class="no-js">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <link rel="canonical" href="{{ canonical_url }}">
  {%- assign meta_description = page_description | default: shop.description -%}
  {%- if meta_description == blank -%}
    {%- assign meta_description = 'PRIVAT — магазин товаров для взрослых в Бишкеке. Бережный подбор без неловкости, анонимная упаковка, доставка за 1 час.' -%}
  {%- endif -%}
  <meta name="description" content="{{ meta_description | escape }}">
  {% render 'seo-meta', meta_description: meta_description %}
  <title>
    {{ page_title }}{% if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags | join: ', ' }}{% endif %}
    {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
    {%- comment -%} бренд добавляем, только если его ещё нет в хранимом title; проверка по 'PRIVAT'/'Privat' устойчива к латинской C в «Cекс» {%- endcomment -%}
    {%- unless page_title contains 'PRIVAT' or page_title contains 'Privat' or page_title contains 'privat' %} &ndash; {{ shop.name }}{% endunless -%}
  </title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" as="style"
    href="https://fonts.googleapis.com/css2?family=Prata&family=Manrope:wght@400;600;700&display=swap"
    onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Prata&family=Manrope:wght@400;600;700&display=swap"></noscript>

  {{ 'theme.css' | asset_url | stylesheet_tag }}

  <script>document.documentElement.classList.remove('no-js');</script>
  <script>
    (function () {
      try {
        var saved = localStorage.getItem('privat-theme');
        if (saved === 'dark' || (!saved && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      } catch (e) {}
    })();
  </script>

  {{ content_for_header }}
</head>
<body>

  <div class="privat-outer">
    <main class="privat-app" id="privat-app">

      <div class="privat-scroller" id="privat-scroller">
        {% section 'header' %}

        {{ content_for_layout }}

        {% section 'footer' %}
      </div>

      {% section 'bottom-nav' %}

      <div class="privat-backdrop" id="privat-backdrop"></div>

      {% section 'menu-drawer' %}
      {% render 'cart-drawer' %}
      {% render 'favorites-drawer' %}
      {% render 'categories-drawer' %}
      {% render 'account-drawer' %}
      {% render 'search-drawer' %}
      {% render 'toast' %}
    </main>
  </div>

  <script id="privat-cart-data" type="application/json">{{ cart | json }}</script>
  <script>
    window.Shopify = window.Shopify || {};
    Shopify.money_format = {{ shop.money_format | json }};
  </script>
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
</body>
</html>
